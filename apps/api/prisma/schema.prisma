generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

/// ============================================================
/// Enums
/// ============================================================
enum Role {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  TEAM_LEAD
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MfaMethod {
  TOTP
  EMAIL_OTP
  SMS_OTP
}

/// ============================================================
/// Core auth
/// ============================================================
model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(PENDING)
  emailVerified DateTime?
  mfaEnabled    Boolean    @default(false)
  mfaSecret     String?    // TOTP secret, encrypted at rest
  mfaBackupCodes String[]  @default([])
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // ─── Profile ──────────────────────────────────────
  skills      String[]  @default([])
  location    String?
  avatarUrl   String?
  bio         String?
  motivation  String?   // from application

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("ActorAuditLogs")

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique // SHA-256 of the raw refresh token
  familyId   String    @db.Uuid // groups a rotation chain; revoke whole family on reuse
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  method     MfaMethod
  codeHash   String    // Argon2id hash of the 6-digit code
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// ============================================================
/// Audit log (immutable)
/// ============================================================
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actorName String?
  action    String   // e.g. "auth.login.success", "user.role.changed"
  target    String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

/// ============================================================
/// Events & field operations
/// ============================================================
enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventCategory {
  CLEANUP
  PLANTING
  AWARENESS
  MEETING
}

enum RsvpStatus {
  GOING
  WAITLIST
  CANCELLED
}

enum ProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Event {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String
  location      String
  lat           Float
  lng           Float
  startsAt      DateTime
  endsAt        DateTime
  status        EventStatus   @default(DRAFT)
  category      EventCategory
  capacity      Int
  coverImageUrl String?
  checkInCode   String        @unique // short human-readable code: MECBO-2024-XXXX
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rsvps    Rsvp[]
  checkIns CheckIn[]
  proofs   ProofOfWork[]

  @@index([status])
  @@index([startsAt])
  @@index([category])
}

model Rsvp {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @db.Uuid
  userId    String     @db.Uuid
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model CheckIn {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  method    String   // "qr" | "code" | "manual"
  checkedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

model ProofOfWork {
  id           String      @id @default(uuid()) @db.Uuid
  clientId     String      @unique // generated on device — ensures idempotency for offline retries
  eventId      String      @db.Uuid
  userId       String      @db.Uuid
  photoUrl     String
  photoKey     String      // storage key for delete
  lat          Float
  lng          Float
  notes        String?
  status       ProofStatus @default(PENDING)
  reviewedById String?     @db.Uuid
  reviewedAt   DateTime?
  capturedAt   DateTime
  createdAt    DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([status])
}

/// ============================================================
/// Impact tracking
/// ============================================================
enum ImpactType {
  TREES_PLANTED
  WASTE_COLLECTED
  HOURS_VOLUNTEERED
  EVENT_ATTENDED
  CARBON_OFFSET
}

enum CertificateType {
  VOLUNTEER_HOURS
  TREES_PLANTED
  WASTE_COLLECTED
  ANNUAL_IMPACT
}

model ImpactLog {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  eventId     String?    @db.Uuid
  type        ImpactType
  value       Float      // kg for waste, count for trees, hours for time, kg CO₂e for carbon
  notes       String?
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([type])
}

model Badge {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String
  icon        String     // "sprout" | "leaf" | "tree" | "recycle" | "droplet" | "sun" | "star"
  targetType  ImpactType
  targetValue Float
  createdAt   DateTime   @default(now())

  awards UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  badgeId  String
  earnedAt DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Certificate {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  type             CertificateType
  title            String
  periodFrom       DateTime
  periodTo         DateTime
  verificationCode String          @unique
  issuedById       String          @db.Uuid
  issuedAt         DateTime        @default(now())

  // Snapshot of metrics at issuance time — immutable
  treesPlanted     Float
  wasteCollectedKg Float
  volunteerHours   Float
  carbonOffsetKg   Float

  @@index([userId])
  @@index([type])
}

/// ============================================================
/// Membership applications
/// ============================================================
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model MembershipApplication {
  id           String            @id @default(uuid()) @db.Uuid
  fullName     String
  email        String
  phone        String
  motivation   String
  skills       String[]          @default([])
  status       ApplicationStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?
  userId       String?           @db.Uuid  // set on approval
  submittedAt  DateTime          @default(now())

  @@index([status])
  @@index([email])
}
// Paste at the END of apps/api/prisma/schema.prisma

/// ============================================================
/// Projects (shown on the public website, edited by admins)
/// ============================================================
enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectPhase {
  PLANNED
  ONGOING
  COMPLETED
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  title         String
  summary       String
  description   String
  status        ProjectStatus @default(DRAFT)
  phase         ProjectPhase  @default(ONGOING)
  location      String?
  startDate     DateTime?
  endDate       DateTime?
  coverImageUrl String?
  highlights    String[]      @default([])
  createdById   String        @db.Uuid
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, phase])
}
