<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#f4f7f4;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;padding:28px;">
      <tr><td>
        <h2 style="margin:0 0 12px;color:#14532d;">Welcome to ME_CBO, {{fullName}}!</h2>
        <p>An administrator has added you to the Mosoriot Environmental Community-Based Organization member portal.</p>
        <p>Choose your own password to activate your account:</p>
        <p style="margin:24px 0;">
          <a href="{{setPasswordUrl}}" style="background:#14532d;color:#ffffff;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:bold;">Set my password</a>
        </p>
        <p style="font-size:13px;color:#6b7280;">This link works for 7 days and can be used once. If the button does not work, copy this address into your browser:<br>{{setPasswordUrl}}</p>
        <p style="font-size:13px;color:#6b7280;">If you were not expecting this email, you can ignore it.</p>
      </td></tr>
    </table>
  </body>
</html>
